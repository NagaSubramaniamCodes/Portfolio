# Canonical site URL used for metadata, Open Graph, the sitemap, and robots.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://nagabuilds.in

# -----------------------------------------------------------------------------
# Contact form delivery — pick ONE option, then copy this file to .env.local
# -----------------------------------------------------------------------------

# Option A: webhook (Formspree, Cloudflare Worker, Make, etc.)
CONTACT_WEBHOOK_URL=

# Option B: Resend email (recommended for nagabuilds.in)
# See setup steps in chat / README.
RESEND_API_KEY=
CONTACT_TO_EMAIL=nagasubramaniamg@gmail.com
CONTACT_FROM_EMAIL=Portfolio <contact@nagabuilds.in>

# Do not commit .env.local or real credentials.
